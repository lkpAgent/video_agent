# ====== LLM 大模型配置 ======
# API Key（必填）
LLM_API_KEY=sk-your-api-key-here
# API 地址（支持 OpenAI 兼容接口）
LLM_BASE_URL=https://api.openai.com/v1
# 模型名称
LLM_MODEL=gpt-4o
# 最大 Token
LLM_MAX_TOKENS=8192

# ====== 图片生成配置 ======
# 是否启用 AI 图片生成
IMAGE_GEN_ENABLED=true
# 提供商: openai(OpenAI DALL-E/gpt-image) / doubao(豆包/火山引擎，更快)
IMAGE_GEN_PROVIDER=openai
# 图片生成 API Key（留空则复用 LLM_API_KEY）
# IMAGE_GEN_API_KEY=
# 图片生成 API 地址（留空默认 OpenAI 官方）
# IMAGE_GEN_BASE_URL=https://api.openai.com/v1
# 图片生成模型
IMAGE_GEN_MODEL=dall-e-3
IMAGE_QUALITY=auto
IMAGE_SIZE=1792x1024

# 豆包（Doubao / 火山引擎）— 速度更快，中文理解好
# IMAGE_GEN_PROVIDER=doubao 时生效
DOUBAO_API_KEY=
DOUBAO_MODEL=doubao-seedream-4-5-251128
DOUBAO_SIZE=2K
# 图片尺寸（16:9）
IMAGE_SIZE=1792x1024

# ====== TTS 语音配置 ======
# 提供商: edge(免费，公开音色) / elevenlabs(声音克隆)
TTS_PROVIDER=edge
# Edge TTS 音色：
#   zh-CN-XiaoxiaoNeural  温柔女声(默认)
#   zh-CN-YunxiNeural     阳光男声
#   zh-CN-YunjianNeural   沉稳男声
#   zh-CN-XiaoyiNeural    活泼女声
TTS_VOICE=zh-CN-XiaoxiaoNeural
TTS_RATE=+10%
TTS_PITCH=+0Hz

# 豆包语音接口（TTS_PROVIDER=doubao 时使用）
# voices.type=1：声音复刻接口；voices.type=2：声音合成接口
DOUBAO_TTS_API_KEY=
DOUBAO_TTS_VOICE_TYPE=
DOUBAO_TTS_CLUSTER=volcano_icl
DOUBAO_TTS_SYNTHESIS_URL=https://openspeech.bytedance.com/api/v3/tts/unidirectional
DOUBAO_TTS_SYNTHESIS_RESOURCE_ID=seed-tts-2.0

# ElevenLabs 声音克隆（TTS_PROVIDER=elevenlabs 时使用）
# 1. 注册 https://elevenlabs.io → 获取 API Key
# 2. 在后台 "Voices" → "Add Generative or Cloned Voice" 上传音频克隆
# 3. 获得 VOICE_ID，填到下面
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2

# ====== 视频配置 ======
# 对外访问地址；如果 Nginx 暴露在 82 端口，就写 http://113.240.110.92:82
PUBLIC_BASE_URL=
# 全局录制方式：selenium / playwright / hyperframes
RECORD_ENGINE=selenium
# Playwright/HyperFrames 不可用时自动回退到 Firefox + Selenium
RECORD_FALLBACK_TO_SELENIUM=true
# URL 正文采集浏览器：服务器建议 selenium；不采集动态页面可设 none
DOC_AGENT_BROWSER_ENGINE=selenium
# 口播视频录制方式：本地可设 playwright，服务器建议 selenium；留空时 hyperframes 会自动回退 selenium
NARRATION_RECORD_ENGINE=
# 可选：显式指定 HyperFrames 命令。旧版 npm/npx 服务器可不填，程序会自动使用：
# npx --package hyperframes hyperframes render ...
HYPERFRAMES_COMMAND=
RECORD_BROWSER=firefox
# 可选：显式指定 geckodriver。Windows 示例 ./tools/geckodriver.exe；Linux 建议留空并从 PATH 查找
GECKODRIVER_PATH=
# 分辨率
VIDEO_WIDTH=1920
VIDEO_HEIGHT=1080
# 帧率
VIDEO_FPS=30
# 音频播放结束后，末帧继续停留的秒数
VIDEO_END_HOLD_SECONDS=2
# 文档类视频 TTS 后处理语速倍率；1.0 为原速，1.2 为略快
DOC_AGENT_TTS_SPEED=1.2
# 主题风格: dark / light / warm
VIDEO_THEME=dark

# ====== 搜索配置 ======
# 搜索引擎: duckduckgo(免费，中文差) / tavily(AI搜索，推荐)
SEARCH_ENGINE=tavily
TAVILY_API_KEY=tvly-your-key-here
SEARCH_MAX_RESULTS=10
SEARCH_REGION=zh-cn

# ====== 输出目录 ======
OUTPUT_DIR=./output
TEMP_DIR=./output/temp
IMAGE_OUTPUT_DIR=./output/images
VIDEO_OUTPUT_DIR=./output
